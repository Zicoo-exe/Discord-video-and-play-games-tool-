delete window.$;
let wpRequire = webpackChunkdiscord_app.push([[Symbol()], {}, r => r]);
webpackChunkdiscord_app.pop();

function findModule(filter) {
  return Object.values(wpRequire.c).find(x => {
    try { return filter(x?.exports) } catch { return false }
  })?.exports
}

Object.values(wpRequire.c).forEach(x => {
  try {
    const m = x?.exports
    if (!m) return
    for (const key of Object.keys(m)) {
      const val = m[key]
      if (!val || typeof val !== "object") continue
      const proto = Object.getPrototypeOf(val)
      const allKeys = [...Object.getOwnPropertyNames(val), ...(proto ? Object.getOwnPropertyNames(proto) : [])]
      for (const fn of allKeys) {
        try {
          if (typeof val[fn] !== "function") continue
          const src = val[fn].toString()
          if (src.includes("Performance snapshot not available") || src.includes("logHeartbeat") || src.includes("scheduleHeartbeatTracking")) {
            const orig = val[fn].bind(val)
            val[fn] = function(...args) {
              try { return orig(...args) } catch(e) { console.log("Suppressed:", e?.message); return Promise.resolve() }
            }
          }
        } catch {}
      }
    }
  } catch {}
})

Object.values(wpRequire.c).forEach(x => {
  try {
    const m = x?.exports
    if (!m) return
    for (const key of Object.keys(m)) {
      if (typeof m[key] !== "function") continue
      const src = m[key].toString()
      if (src.includes("Performance snapshot not available") || src.includes("getPerformanceSnapshot") || src.includes("logHeartbeat") || src.includes("processSessionChanges")) {
        const orig = m[key]
        m[key] = function(...args) {
          try { return orig.apply(this, args) } catch(e) { return Promise.resolve() }
        }
      }
    }
  } catch {}
})

let ApplicationStreamingStore = findModule(e => e?.A?.getStreamerActiveStreamMetadata)?.A
  ?? findModule(e => e?.default?.getStreamerActiveStreamMetadata)?.default

let RunningGameStore = findModule(e => e?.Ay?.getRunningGames)?.Ay
  ?? findModule(e => e?.default?.getRunningGames)?.default
  ?? findModule(e => e?.Z?.getRunningGames)?.Z

let QuestsStore = findModule(e => e?.A?.getQuest)?.A
  ?? findModule(e => e?.default?.getQuest)?.default
  ?? findModule(e => e?.Z?.getQuest)?.Z

let ChannelStore = findModule(e => e?.A?.getAllThreadsForParent)?.A
  ?? findModule(e => e?.default?.getAllThreadsForParent)?.default

let GuildChannelStore = findModule(e => e?.Ay?.getSFWDefaultChannel)?.Ay
  ?? findModule(e => e?.default?.getSFWDefaultChannel)?.default

let FluxDispatcher = findModule(e => e?.h?.flushWaitQueue)?.h
  ?? findModule(e => e?.default?.flushWaitQueue)?.default
  ?? findModule(e => e?.Z?.flushWaitQueue)?.Z

let api = findModule(e => e?.Bo?.get)?.Bo
  ?? findModule(e => e?.default?.get && e?.default?.post)?.default
  ?? findModule(e => e?.Z?.get && e?.Z?.post)?.Z

// fallback deep scan for any missing stores
if (!RunningGameStore) {
  RunningGameStore = Object.values(wpRequire.c).map(x => x?.exports).flatMap(e => {
    if (!e) return []
    return [e, ...Object.values(e).filter(v => v && typeof v === "object")]
  }).find(e => typeof e?.getRunningGames === "function")
}

if (!FluxDispatcher) {
  FluxDispatcher = Object.values(wpRequire.c).map(x => x?.exports).flatMap(e => {
    if (!e) return []
    return [e, ...Object.values(e).filter(v => v && typeof v === "object")]
  }).find(e => typeof e?.dispatch === "function" && typeof e?.subscribe === "function")
}

if (!api) {
  api = Object.values(wpRequire.c).map(x => x?.exports).flatMap(e => {
    if (!e) return []
    return [e, ...Object.values(e).filter(v => v && typeof v === "object")]
  }).find(e => typeof e?.get === "function" && typeof e?.post === "function")
}

console.log("isApp:", typeof DiscordNative !== "undefined")
console.log("RunningGameStore:", !!RunningGameStore)
console.log("FluxDispatcher:", !!FluxDispatcher)
console.log("QuestsStore:", !!QuestsStore)
console.log("api:", !!api)

if (!QuestsStore || !FluxDispatcher || !api) {
  console.error("Critical module missing — cannot proceed.")
} else {

const supportedTasks = ["WATCH_VIDEO", "WATCH_VIDEO_ON_MOBILE", "PLAY_ON_DESKTOP", "STREAM_ON_DESKTOP", "PLAY_ACTIVITY"]

let quests = [...QuestsStore.quests.values()].filter(x =>
  x.userStatus?.enrolledAt &&
  !x.userStatus?.completedAt &&
  new Date(x.config.expiresAt).getTime() > Date.now() &&
  supportedTasks.find(y => Object.keys((x.config.taskConfig ?? x.config.taskConfigV2).tasks).includes(y))
)

console.log(`Found ${quests.length} active quest(s):`)
quests.forEach(q => {
  const tc = q.config.taskConfig ?? q.config.taskConfigV2
  console.log(` → ${q.config.messages.questName}: ${Object.keys(tc.tasks).join(", ")}`)
})

let isApp = typeof DiscordNative !== "undefined"

if (quests.length === 0) {
  console.log("No uncompleted quests found.")
} else {

  let doJob = function () {
    const quest = quests.pop()
    if (!quest) { console.log("All quests processed."); return }

    const pid = Math.floor(Math.random() * 30000) + 1000
    const questName = quest.config.messages.questName
    const taskConfig = quest.config.taskConfig ?? quest.config.taskConfigV2
    const taskName = supportedTasks.find(x => taskConfig.tasks[x] != null)
    const taskData = taskConfig.tasks[taskName]
    const applicationId = quest.config.application?.id ?? taskData.applications?.[0]?.id
    const secondsNeeded = taskData.target
    let secondsDone = quest.userStatus?.progress?.[taskName]?.value ?? 0

    console.log(`Processing: ${questName} | task: ${taskName} | ${secondsDone}/${secondsNeeded}s done`)

    // ── WATCH VIDEO ──────────────────────────────────────────────
    if (taskName === "WATCH_VIDEO" || taskName === "WATCH_VIDEO_ON_MOBILE") {
      let fn = async () => {
        const bodyShapes = [
          { timestamp: Math.floor(secondsNeeded) },
          { progress: Math.floor(secondsNeeded) },
          { timestamp: Math.floor(secondsNeeded), progress: Math.floor(secondsNeeded) },
          { video_progress: Math.floor(secondsNeeded) },
          { watched_seconds: Math.floor(secondsNeeded) },
          { seconds_watched: Math.floor(secondsNeeded) },
        ]

        let success = false
        for (const body of bodyShapes) {
          try {
            const res = await api.post({ url: `/quests/${quest.id}/video-progress`, body })
            if (res.ok || res.status === 200 || res.status === 204) {
              console.log(`✓ Video quest done! Shape: ${JSON.stringify(body)}`)
              success = true
              break
            } else {
              console.log(`✗ ${JSON.stringify(body)} → ${res.status}:`, res.body)
            }
          } catch(e) {
            console.log(`✗ ${JSON.stringify(body)} threw:`, e?.message)
          }
        }

        if (!success) {
          console.warn("All video-progress shapes failed. Open Network tab, watch 1s of quest video, copy the real request body, add it to bodyShapes[].")
        }
        doJob()
      }
      console.log(`Starting video quest: ${questName}`)
      fn()

    // ── PLAY ON DESKTOP ──────────────────────────────────────────
    } else if (taskName === "PLAY_ON_DESKTOP") {
      if (!isApp) {
        console.log(`PLAY_ON_DESKTOP requires Discord desktop app — skipping ${questName}`)
        doJob()
        return
      }

      api.get({ url: `/applications/public?application_ids=${applicationId}` }).then(res => {
        const appData = res.body[0]
        const exeName = appData.executables?.find(x => x.os === "win32")?.name?.replace(">", "")
          ?? appData.name.replace(/[\/\\:*?"<>|]/g, "") + ".exe"

        const fakeGame = {
          cmdLine: `C:\\Program Files\\${appData.name}\\${exeName}`,
          exeName,
          exePath: `c:/program files/${appData.name.toLowerCase()}/${exeName}`,
          hidden: false,
          isLauncher: false,
          id: applicationId,
          name: appData.name,
          pid,
          pidPath: [pid],
          processName: appData.name,
          start: Date.now(),
        }

        const realGames = RunningGameStore.getRunningGames()
        const fakeGames = [fakeGame]
        const realGetRunningGames = RunningGameStore.getRunningGames
        const realGetGameForPID = RunningGameStore.getGameForPID

        RunningGameStore.getRunningGames = () => fakeGames
        RunningGameStore.getGameForPID = (p) => fakeGames.find(x => x.pid === p)

        FluxDispatcher.dispatch({ type: "RUNNING_GAMES_CHANGE", removed: realGames, added: [fakeGame], games: fakeGames })
        setTimeout(() => {
          FluxDispatcher.dispatch({ type: "RUNNING_GAMES_CHANGE", removed: [], added: [fakeGame], games: fakeGames })
        }, 500)

        let fn = data => {
          let progress
          if (quest.config.configVersion === 1) {
            progress = data.userStatus.streamProgressSeconds ?? 0
          } else {
            progress = Math.floor(
              data.userStatus.progress?.PLAY_ON_DESKTOP?.value
              ?? data.userStatus.streamProgressSeconds
              ?? 0
            )
          }
          console.log(`[${questName}] progress: ${progress}/${secondsNeeded}`)

          if (progress >= secondsNeeded) {
            console.log(`✓ ${questName} completed!`)
            RunningGameStore.getRunningGames = realGetRunningGames
            RunningGameStore.getGameForPID = realGetGameForPID
            FluxDispatcher.dispatch({ type: "RUNNING_GAMES_CHANGE", removed: [fakeGame], added: [], games: [] })
            FluxDispatcher.unsubscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", fn)
            doJob()
          }
        }
        FluxDispatcher.subscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", fn)
        console.log(`Spoofed ${appData.name}. ~${Math.ceil((secondsNeeded - secondsDone) / 60)} min remaining.`)
      }).catch(e => {
        console.error("Failed to fetch app data:", e)
        doJob()
      })

    // ── STREAM ON DESKTOP ────────────────────────────────────────
    } else if (taskName === "STREAM_ON_DESKTOP") {
      if (!isApp) {
        console.log(`STREAM_ON_DESKTOP requires Discord desktop app — skipping ${questName}`)
        doJob()
        return
      }

      let realFunc = ApplicationStreamingStore.getStreamerActiveStreamMetadata
      ApplicationStreamingStore.getStreamerActiveStreamMetadata = () => ({
        id: applicationId,
        pid,
        sourceName: null
      })

      let fn = data => {
        let progress
        if (quest.config.configVersion === 1) {
          progress = data.userStatus.streamProgressSeconds ?? 0
        } else {
          progress = Math.floor(
            data.userStatus.progress?.STREAM_ON_DESKTOP?.value
            ?? data.userStatus.streamProgressSeconds
            ?? 0
          )
        }
        console.log(`[${questName}] progress: ${progress}/${secondsNeeded}`)

        if (progress >= secondsNeeded) {
          console.log(`✓ ${questName} completed!`)
          ApplicationStreamingStore.getStreamerActiveStreamMetadata = realFunc
          FluxDispatcher.unsubscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", fn)
          doJob()
        }
      }
      FluxDispatcher.subscribe("QUESTS_SEND_HEARTBEAT_SUCCESS", fn)
      console.log(`Spoofed stream for ${questName}. ~${Math.ceil((secondsNeeded - secondsDone) / 60)} min remaining. Need 1+ person in vc.`)

    // ── PLAY ACTIVITY ────────────────────────────────────────────
    } else if (taskName === "PLAY_ACTIVITY") {
      const channelId = ChannelStore.getSortedPrivateChannels()[0]?.id
        ?? Object.values(GuildChannelStore.getAllGuilds()).find(x => x != null && x.VOCAL?.length > 0)?.VOCAL[0]?.channel?.id

      if (!channelId) {
        console.error("No channel found for PLAY_ACTIVITY — join a vc first")
        doJob()
        return
      }

      const streamKey = `call:${channelId}:1`

      let fn = async () => {
        console.log(`Starting PLAY_ACTIVITY for ${questName}`)
        while (true) {
          try {
            const res = await api.post({
              url: `/quests/${quest.id}/heartbeat`,
              body: { stream_key: streamKey, terminal: false }
            })
            const progress = res.body?.progress?.PLAY_ACTIVITY?.value ?? 0
            console.log(`[${questName}] progress: ${progress}/${secondsNeeded}`)
            if (progress >= secondsNeeded) {
              await api.post({ url: `/quests/${quest.id}/heartbeat`, body: { stream_key: streamKey, terminal: true } })
              console.log(`✓ ${questName} completed!`)
              break
            }
          } catch(e) {
            console.error("Heartbeat error:", e?.message)
          }
          await new Promise(r => setTimeout(r, 2000))
        }
        doJob()
      }
      fn()
    }
  }

  doJob()
}
}
